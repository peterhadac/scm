---
import { flattenProducts, safeUrl, type RoastType } from '../lib/coffees';
import { UI, localizedOrigin, localizedProcess, localizedRoastType, type Lang } from '../lib/i18n';
import { loadPriceHistory, historyKey, sparklinePoints } from '../lib/priceHistory';
import Badge from './ui/Badge.astro';

interface Props {
  roastType?: RoastType;
  origin?: string;
  blend?: boolean;
  lang?: Lang;
}

const { roastType, origin, blend, lang: langProp } = Astro.props;

const lang: Lang = langProp ?? (Astro.locals.starlightRoute?.lang === 'sk' ? 'sk' : 'en');
const t = UI[lang];

const allCoffees = flattenProducts();
let coffees = roastType
  ? allCoffees.filter((c) => c.roast_type === roastType)
  : allCoffees;
if (origin) coffees = coffees.filter((c) => c.origin === origin);
if (blend !== undefined) coffees = coffees.filter((c) => (c.origin === 'Blend') === blend);

const priceHistory = loadPriceHistory();

const STALE_THRESHOLD_DAYS = 21;
const now = new Date();
function isStale(lastSeen: string | undefined | null): boolean {
  if (!lastSeen) return false;
  const seen = new Date(lastSeen);
  if (Number.isNaN(seen.getTime())) return false;
  const ageDays = (now.getTime() - seen.getTime()) / (1000 * 60 * 60 * 24);
  return ageDays > STALE_THRESHOLD_DAYS;
}

const PROCESS_BADGE_CLASSES = new Set(['washed', 'natural', 'honey']);

// ── Build-time stats ──────────────────────────────────────
const total = coffees.length;
const roasterCount = new Set(coffees.map((c) => c.roaster)).size;
const cheapest = total ? Math.min(...coffees.map((c) => c.price)) : null;
const lastUpdated = coffees.reduce(
  (max, c) => (c.last_seen && c.last_seen > max ? c.last_seen : max),
  '',
);

const MIN_ROWS_FOR_BEST_VALUE = 3;
const per100gValues = coffees
  .filter((c) => c.weight_g)
  .map((c) => (c.price / c.weight_g) * 100);
const bestPer100g =
  per100gValues.length && total >= MIN_ROWS_FOR_BEST_VALUE ? Math.min(...per100gValues) : null;

const fmtEur = (n: number) => `€${n.toFixed(2)}`;

// ── Individual card ────────────────────────────────────── 
function CoffeeCard({ coffee: c, index: i }: { coffee: typeof coffees[number]; index: number }) {
  const per100gNum = c.weight_g ? (c.price / c.weight_g) * 100 : null;
  const per100g = per100gNum !== null ? fmtEur(per100gNum) : '—';
  const isBest = per100gNum !== null && bestPer100g !== null && per100gNum <= bestPer100g + 0.001;
  const stale = isStale(c.last_seen);
  const originLabel = localizedOrigin(c.origin, lang);
  const processLabel = localizedProcess(c.process, lang);
  const blendComposition = (c.blend_origins ?? []).map((country) => localizedOrigin(country, lang) ?? country).join(' + ');

  const series = c.weight_g
    ? priceHistory.get(historyKey(c.url, c.weight_g, c.variant)) ?? []
    : [];
  const hasSpark = series.length >= 2;
  const prevPoint = hasSpark ? series[series.length - 2] : null;
  const dropped = prevPoint !== null && series[series.length - 1].price < prevPoint.price;

  return (
    <li
      style={{ '--i': Math.min(i, 20) } as any}
      data-name={c.name}
      data-roaster={c.roaster}
      data-origin={c.origin ?? ''}
      data-process={c.process ?? ''}
      data-roast={c.roast_type ?? ''}
      data-weight={c.weight_g ?? ''}
      data-price={c.price}
      data-per100g={per100gNum !== null ? per100gNum.toFixed(4) : ''}
      class:list={[isBest ? 'coffee-card--best' : undefined, 'coffee-card']}
    >
      <div class="cc-top">
        <a href={safeUrl(c.url)} target="_blank" rel="noopener noreferrer" class="cc-link">
          {c.name}
          <svg class="cc-ext" width="9" height="9" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M1.5 8.5L8.5 1.5M8.5 1.5H3.5M8.5 1.5V6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a class="cc-report"
          href={`https://github.com/peterhadac/scm/issues/new?template=wrong-data.yml&title=${encodeURIComponent('Wrong data: ' + c.name)}&product-url=${encodeURIComponent(c.url)}`}
          target="_blank" rel="noopener noreferrer"
          title={t.reportRowTitle(c.name)} aria-label={t.reportRowTitle(c.name)}
        >
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M2 9V1.5M2 1.5h5.5L6 3.25 7.5 5H2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
      <div class="cc-body">
        <span class="cc-roaster">{c.roaster}</span>
        <span class="cc-origin cc-muted">{originLabel ?? '—'}{blendComposition && <span class="cc-blend-comp">({blendComposition})</span>}</span>
        <span class="cc-process">
          {c.process
            ? <>
                {blendComposition && <span class="cc-blend-comp">{blendComposition}</span>}
                <Badge variant={(PROCESS_BADGE_CLASSES.has(c.process) ? c.process : 'other') as any}>{processLabel}</Badge>
                {c.is_decaffeinated && <span class="cc-decaf-tag">DEC</span>}
              </>
            : <span class="cc-muted">—</span>
          }
        </span>
      </div>
      <div class="cc-footer">
        <span class="cc-weight cc-muted">{c.weight_g !== null ? `${c.weight_g} g${c.variant ? ` (${c.variant})` : ''}` : '—'}</span>
        <span class="cc-price">
          {hasSpark && (
            <svg class="cc-spark" width="56" height="14" viewBox="0 0 56 14" role="img" aria-label={t.sparklineLabel(series[0].date)}>
              <title>{t.sparklineLabel(series[0].date)}</title>
              <polyline points={sparklinePoints(series)} fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          )}
          {fmtEur(c.price)}
          {dropped && prevPoint && (
            <span class="cc-drop" title={t.priceDropTitle(fmtEur(prevPoint.price), prevPoint.date)}>↓ {t.priceDrop}</span>
          )}
          {c.stock_status === 'out-of-stock' && <span style={{marginLeft:'6px',background:'#ff444433',color:'#ff4444',fontSize:'0.75em',padding:'1px 4px',borderRadius:'3px'}}>Out</span>}
          {c.stock_status === 'pre-order' && <span style={{marginLeft:'6px',background:'#ffaa0033',color:'#cc8800',fontSize:'0.75em',padding:'1px 4px',borderRadius:'3px'}}>Pre</span>}
          {stale && (
            <span class="cc-stale" title={t.staleTitle(c.last_seen)} aria-label={t.staleAriaLabel(c.last_seen)}>
              <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M6 1.2L11 10.2H1L6 1.2Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
                <path d="M6 4.6V6.6" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
                <circle cx="6" cy="8.4" r="0.55" fill="currentColor"/>
              </svg>
            </span>
          )}
        </span>
        <span class="cc-per100g cc-muted cc-num">{per100g}{isBest && <span class="cc-best" title={t.bestValueTitle}>{t.bestValue}</span>}</span>
        {c.referral_url || c.discount_code
          ? <span class="cc-offers"><a href={c.referral_url} target="_blank" rel="noopener" class="cc-refer-link">{c.discount_code || '—'}</a></span>
          : <span class="cc-offers cc-muted">—</span>
        }
      </div>
    </li>
  );
}

<div class="cc-wrap">
  <!-- ── Compact summary ──────────────────────────────────── -->
  <p class="cc-summary">
    <strong>{t.coffeeCount(total)}</strong> · <strong>{t.roasterCount(roasterCount)}</strong>
    {cheapest !== null && <> · {t.from} <strong>{fmtEur(cheapest)}</strong></>}
    {lastUpdated && (
      <> · <span class="cc-fresh-dot" aria-hidden="true"></span> {t.updated} <time datetime={lastUpdated}>{lastUpdated}</time></>
    )}
  </p>

  <!-- ── Layout: sidebar + card-grid ──────────────────────────── -->
  <div class="cc-layout">
    <!-- Left sidebar: filters -->
    <aside class="cc-sidebar">
      <div class="cc-sidebar-field">
        <label class="cc-label" for="cc-search">{t.search}</label>
        <div class="cc-field">
          <svg class="cc-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="6" cy="6" r="4.25" stroke="currentColor" stroke-width="1.5"/>
            <path d="M9.5 9.5L12.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <input id="cc-search" type="search" class="cc-input" placeholder={t.searchPlaceholder} autocomplete="off"/>
        </div>
      </div>

      <details class="cc-details" open>
        <summary class="cc-details-summary">
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 4h10M4 7h6M5.5 10h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          {t.roaster}
        </summary>
        <select id="cc-roaster" class="cc-select"><option value="">{t.all}</option></select>
      </details>

      <details class="cc-details" open>
        <summary class="cc-details-summary">
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 4h10M4 7h6M5.5 10h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          {t.origin}
        </summary>
        <select id="cc-origin" class="cc-select"><option value="">{t.all}</option></select>
      </details>

      <details class="cc-details" open>
        <summary class="cc-details-summary">
          <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 4h10M4 7h6M5.5 10h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          {t.process}
        </summary>
        <select id="cc-process" class="cc-select"><option value="">{t.all}</option></select>
      </details>

      {!roastType && (
        <details class="cc-details" open>
          <summary class="cc-details-summary">
            <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 4h10M4 7h6M5.5 10h3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            {t.roast}
          </summary>
          <select id="cc-roast" class="cc-select">
            <option value="">{t.all}</option>
            <option value="filter">{localizedRoastType('filter', lang)}</option>
            <option value="espresso">{localizedRoastType('espresso', lang)}</option>
            <option value="nespresso">{localizedRoastType('nespresso', lang)}</option>
            <option value="drip-bag">{localizedRoastType('drip-bag', lang)}</option>
          </select>
        </details>
      )}
    </aside>

    <!-- Right: main product area -->
    <main class="cc-main" aria-label={t.searchPlaceholder}>
      <div class="cc-card-header">
        <span id="cc-count" class="cc-count" aria-live="polite"></span>
        <div class="cc-sort-group">
          <label for="cc-sort" class="cc-label cc-label--inline">{t.sort}</label>
          <select id="cc-sort" class="cc-sort-select">
            <option value="price">{t.sortByPrice}</option>
            <option value="name">{t.sortByName}</option>
            <option value="roaster">{t.sortByRoaster}</option>
            <option value="origin">{t.sortByOrigin}</option>
          </select>
        </div>
        <button id="cc-clear" class="cc-clear-btn" hidden>
          <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 3L9 9M9 3L3 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          {t.clear}
        </button>
      </div>

      <div class="cc-filters-badge" id="cc-filters-badge" hidden></div>

      <p id="cc-empty" hidden class="cc-empty">{t.emptyFiltered}</p>

      <ul id="cc-grid" class="cc-grid">
        <!-- Server-rendered cards — Badge and other components work fine in template loops -->
        {coffees.map((c, i) => <CoffeeCard coffee={c} index={i} key={i} />)}
      </ul>
    </main>
  </div>

  <!-- ── Process legend (replaces row-based badge legend) ────────── -->
  <div class="cc-legend">
    <span class="cc-legend-label">{t.processLegendLabel}</span>
    <span class="cc-legend-sep" aria-hidden="true">·</span>
    <Badge variant="washed" class="cc-badge-sm">{localizedProcess('washed', lang)}</Badge>
    <Badge variant="honey" class="cc-badge-sm">{localizedProcess('honey', lang)}</Badge>
    <Badge variant="natural" class="cc-badge-sm">{localizedProcess('natural', lang)}</Badge>
    {bestPer100g !== null && (
      <>
        <span class="cc-legend-sep" aria-hidden="true">·</span>
        <span class="cc-best" title={t.bestValueTitle}>{t.bestValue}</span>
        <span class="cc-legend-desc">{t.bestValueDesc}</span>
      </>
    )}
  </div>
</div>

<!-- Client interactivity: filtering, sorting, dropdowns -->
<script>
  import { UI, ORIGIN_LABELS, PROCESS_LABELS, type Lang } from '../lib/i18n';

  const lang: Lang = document.documentElement.lang === 'sk' ? 'sk' : 'en';
  const t = UI[lang];

  function foldDiacritics(s: string): string {
    return s.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  }

  const grid = document.getElementById('cc-grid')!;
  const cards = Array.from(grid.querySelectorAll<HTMLLIElement>('.coffee-card'));
  const emptyState = document.getElementById('cc-empty')!;
  const countEl = document.getElementById('cc-count')!;
  const filtersBadge = document.getElementById('cc-filters-badge')!;
  const searchInput = document.getElementById('cc-search') as HTMLInputElement;
  const roasterSel = document.getElementById('cc-roaster') as HTMLSelectElement;
  const originSel = document.getElementById('cc-origin') as HTMLSelectElement;
  const processSel = document.getElementById('cc-process') as HTMLSelectElement;
  const roastSel = document.getElementById('cc-roast') as HTMLSelectElement | null;
  const sortSel = document.getElementById('cc-sort') as HTMLSelectElement | null;
  const clearBtn = document.getElementById('cc-clear') as HTMLButtonElement;

  if (cards.length === 0) {
    emptyState.textContent = t.emptyNoData;
  }

  // Label lookup for populating dropdowns
  function labelFor(attr: 'roaster' | 'origin' | 'process' | 'roast', value: string): string {
    if (attr === 'origin') return ORIGIN_LABELS[value]?.[lang] ?? value;
    if (attr === 'process') return PROCESS_LABELS[value]?.[lang] ?? value;
    return value;
  }

  function populateSelect(id: string, attr: 'roaster' | 'origin' | 'process' | 'roast') {
    const select = document.getElementById(id) as HTMLSelectElement | null;
    if (!select) return;
    const values = [...new Set(cards.map(r => r.dataset[attr]).filter(Boolean))] as string[];
    const options = values
      .map((value) => ({ value, label: labelFor(attr, value) }))
      .sort((a, b) => a.label.localeCompare(b.label, lang));
    for (const { value, label } of options) {
      const opt = document.createElement('option');
      opt.value = value;
      opt.textContent = label;
      select.appendChild(opt);
    }
  }
  populateSelect('cc-roaster', 'roaster');
  populateSelect('cc-origin', 'origin');
  populateSelect('cc-process', 'process');

  let searchTerm = '';

  function filtersActive() {
    return !!(searchTerm || roasterSel.value || originSel.value || processSel.value || roastSel?.value || sortSel?.value);
  }

  function applyFilters() {
    const roaster = roasterSel.value;
    const origin  = originSel.value;
    const process = processSel.value;
    const roast   = roastSel?.value ?? '';

    if (sortSel) {
      sortByColumn(sortSel.value);
    }

    const q = searchTerm;
    let count = 0;
    for (const card of cards) {
      const haystack = foldDiacritics(
        (card.dataset.name || '').toLowerCase() + ' ' +
        (card.dataset.roaster || '').toLowerCase(),
      );
      const match =
        (!q       || haystack.includes(q))                &&
        (!roaster || card.dataset.roaster === roaster)     &&
        (!origin  || card.dataset.origin  === origin)      &&
        (!process || card.dataset.process === process)     &&
        (!roast   || card.dataset.roast   === roast);
      card.hidden = !match;
      if (match) count++;
    }
    emptyState.hidden = count > 0;
    grid.hidden = count === 0;
    countEl.textContent = t.coffeeCount(count);
    clearBtn.classList.toggle('cc-hidden', !filtersActive());
    filtersBadge.classList.toggle('cc-hidden', [roaster, origin, process, roast].filter(Boolean).length === 0);
  }

  function sortByColumn(key: string) {
    if (key === 'price') {
      cards.sort((a, b) => (parseFloat(a.dataset.price || '0') || 0) - (parseFloat(b.dataset.price || '0') || 0));
    } else if (key === 'name') {
      cards.sort((a, b) => (a.dataset.name || '').localeCompare(b.dataset.name || '', lang));
    } else if (key === 'roaster') {
      cards.sort((a, b) => (a.dataset.roaster || '').localeCompare(b.dataset.roaster || '', lang));
    } else if (key === 'origin') {
      cards.sort((a, b) => {
        const ra = a.dataset.origin || '';
        const rb = b.dataset.origin || '';
        const la = ORIGIN_LABELS[ra]?.[lang] ?? ra;
        const lb = ORIGIN_LABELS[rb]?.[lang] ?? rb;
        return la.localeCompare(lb, lang);
      });
    }
    cards.forEach(card => grid.appendChild(card));
  }

  let searchTimer: ReturnType<typeof setTimeout>;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      searchTerm = foldDiacritics(searchInput.value.trim().toLowerCase());
      applyFilters();
    }, 150);
  });

  roasterSel.addEventListener('change', applyFilters);
  originSel.addEventListener('change',  applyFilters);
  processSel.addEventListener('change', applyFilters);
  roastSel?.addEventListener('change',  applyFilters);
  sortSel?.addEventListener('change',  applyFilters);

  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    searchTerm = '';
    roasterSel.value = '';
    originSel.value  = '';
    processSel.value = '';
    if (roastSel) roastSel.value = '';
    if (sortSel) sortSel.value = 'price';
    applyFilters();
    searchInput.focus();
  });

  applyFilters();
  sortByColumn('price');
</script>

<!-- Server-rendered cards injected via Astro template -->

<style>
  /* ── Layout grid ──────────────────────────────────────── */
  .cc-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .cc-summary {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3em;
    margin: 0;
    font-size: var(--md-sys-typescale-label-small-size);
    color: var(--md-sys-color-outline);
  }
  .cc-summary strong { color: var(--md-sys-color-on-surface-variant); font-weight: 600; }

  @keyframes dot-pulse {
    0%  { box-shadow: 0 0 0 0px color-mix(in srgb, var(--md-sys-color-secondary) 50%, transparent); }
    60% { box-shadow: 0 0 0 5px color-mix(in srgb, var(--md-sys-color-secondary) 0%, transparent); }
    100%{ box-shadow: 0 0 0 0px color-mix(in srgb, var(--md-sys-color-secondary) 0%, transparent); }
  }
  .cc-fresh-dot {
    width: 0.5rem; height: 0.5rem; border-radius: 50%;
    background: var(--md-sys-color-secondary);
    animation: dot-pulse 2.4s ease-in-out infinite;
  }

  /* ── Sidebar + Main layout ──────────────────────────── */
  .cc-layout {
    display: flex;
    gap: 2rem;
  }

  .cc-sidebar {
    width: 12rem;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cc-sidebar-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cc-label {
    font-size: var(--md-sys-typescale-label-small-size);
    font-weight: 300;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--md-sys-color-outline);
  }
  .cc-label--inline { display: inline; }

  .cc-field {
    position: relative;
    display: flex;
    align-items: center;
  }
  .cc-icon {
    position: absolute;
    left: 8px;
    color: var(--md-sys-color-outline);
    pointer-events: none;
  }

  .cc-input {
    width: 100%;
    padding: 6px 8px 6px 30px;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface);
    font-size: var(--md-sys-typescale-body-medium-size);
    transition: border-color var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard), background var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard);
  }
  .cc-input:hover { border-color: var(--md-sys-color-outline); background: var(--md-sys-color-surface-container-highest); }
  .cc-input:focus-visible {
    outline: none;
    box-shadow: var(--md3-focus-ring);
    border-color: var(--md-sys-color-primary);
  }

  /* Accordion-style filter details */
  .cc-details {
    border: none;
    padding: 0;
  }
  .cc-details-summary {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 0;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: var(--md-sys-typescale-body-medium-size);
    color: var(--md-sys-color-on-surface-variant);
    list-style: none;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
  }
  .cc-details-summary::-webkit-details-marker { display: none; }
  .cc-details-summary::marker { content: none; }
  .cc-details[open] .cc-details-summary svg { transform: rotate(90deg); }
  .cc-details-summary svg { transition: transform var(--md-sys-motion-duration-short3) var(--md-sys-motion-easing-standard); }

  .cc-details > .cc-select {
    margin: 4px 0 4px 20px;
  }

  .cc-select {
    width: 100%;
    padding: 5px 8px;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    background: var(--md-sys-color-surface-container-highest);
    color: var(--md-sys-color-on-surface);
    font-size: var(--md-sys-typescale-body-medium-size);
    cursor: pointer;
    transition: border-color var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard);
  }
  .cc-select:focus-visible {
    outline: none;
    box-shadow: var(--md3-focus-ring);
    border-color: var(--md-sys-color-primary);
  }

  .cc-main {
    flex: 1;
    min-width: 0;
  }

  .cc-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .cc-count {
