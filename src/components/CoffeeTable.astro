---
import sampleCoffees from '../../_data/coffees.sample.json';
import prodCoffees from '../../_data/coffees.json';

interface Props {
  // When set, page is locked to one roast profile: the Roast dropdown is
  // hidden and only matching coffees are shown (used by the filter/espresso
  // submenu pages). Omit to show every coffee with a Roast filter.
  roastType?: 'filter' | 'espresso';
}

const { roastType } = Astro.props;

const allCoffees = import.meta.env.DEV ? sampleCoffees : prodCoffees;
const coffees = roastType
  ? allCoffees.filter((c) => c.roast_type === roastType)
  : allCoffees;

function processType(p: string | null): 'washed' | 'natural' | 'honey' | null {
  if (!p) return null;
  const l = p.toLowerCase();
  if (l.includes('umyt') || l.includes('washed')) return 'washed';
  if (l.includes('prírodn') || l.includes('natural')) return 'natural';
  if (l.includes('med') || l.includes('honey')) return 'honey';
  return null;
}

// ── Build-time stats derived from the imported JSON ──────────────
const total = coffees.length;
const roasterCount = new Set(coffees.map((c) => c.roaster)).size;
const cheapest = total ? Math.min(...coffees.map((c) => c.price)) : null;
const lastUpdated = coffees.reduce(
  (max, c) => (c.last_seen && c.last_seen > max ? c.last_seen : max),
  '',
);

// Lowest €/100g across items that state a weight → "best value" highlight.
const per100gValues = coffees
  .filter((c) => c.weight_g)
  .map((c) => (c.price / (c.weight_g as number)) * 100);
const bestPer100g = per100gValues.length ? Math.min(...per100gValues) : null;

const fmtEur = (n: number) => `€${n.toFixed(2)}`;
---

<div class="ct-wrap">
  <!-- ── Stats / freshness header ─────────────────────────────── -->
  <div class="ct-stats" role="group" aria-label="Catalogue summary">
    <div class="ct-stat">
      <span class="ct-stat-value">{total}</span>
      <span class="ct-stat-label">coffees</span>
    </div>
    <div class="ct-stat">
      <span class="ct-stat-value">{roasterCount}</span>
      <span class="ct-stat-label">roasters</span>
    </div>
    {cheapest !== null && (
      <div class="ct-stat">
        <span class="ct-stat-value">{fmtEur(cheapest)}</span>
        <span class="ct-stat-label">cheapest</span>
      </div>
    )}
    {lastUpdated && (
      <div class="ct-stat ct-stat--fresh">
        <span class="ct-stat-value">
          <span class="ct-fresh-dot" aria-hidden="true"></span>
          <time datetime={lastUpdated}>{lastUpdated}</time>
        </span>
        <span class="ct-stat-label">data updated</span>
      </div>
    )}
  </div>

  <div class="ct-toolbar">
    <div class="ct-search-group">
      <label class="ct-label" for="filter-search">Search</label>
      <div class="ct-search-field">
        <svg class="ct-search-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <circle cx="6" cy="6" r="4.25" stroke="currentColor" stroke-width="1.5"/>
          <path d="M9.5 9.5L12.5 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <input
          id="filter-search"
          type="search"
          class="ct-search"
          placeholder="Coffee or roaster…"
          autocomplete="off"
          aria-describedby="result-count"
        />
      </div>
    </div>
    <div class="ct-filters">
      <div class="ct-filter-group">
        <label class="ct-label" for="filter-roaster">Roaster</label>
        <select id="filter-roaster" class="ct-select"><option value="">All</option></select>
      </div>
      <div class="ct-filter-group">
        <label class="ct-label" for="filter-origin">Origin</label>
        <select id="filter-origin" class="ct-select"><option value="">All</option></select>
      </div>
      <div class="ct-filter-group">
        <label class="ct-label" for="filter-process">Process</label>
        <select id="filter-process" class="ct-select"><option value="">All</option></select>
      </div>
      {!roastType && (
        <div class="ct-filter-group">
          <label class="ct-label" for="filter-roast">Roast</label>
          <select id="filter-roast" class="ct-select">
            <option value="">All</option>
            <option value="filter">Filter</option>
            <option value="espresso">Espresso</option>
          </select>
        </div>
      )}
    </div>
    <div class="ct-actions">
      <button id="clear-filters" type="button" class="ct-clear-btn" hidden>
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M3 3L9 9M9 3L3 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        Clear
      </button>
      <span id="result-count" class="ct-count" aria-live="polite"></span>
    </div>
  </div>

  <div class="ct-legend" aria-label="Process colour key">
    <span class="ct-legend-label">Process:</span>
    <span class="ct-badge ct-badge--washed">Washed</span>
    <span class="ct-badge ct-badge--honey">Honey</span>
    <span class="ct-badge ct-badge--natural">Natural</span>
    <span class="ct-legend-sep" aria-hidden="true">·</span>
    <span class="ct-best" title="Lowest price per 100g">best value</span>
    <span class="ct-legend-desc">= lowest €/100g</span>
  </div>

  <p id="empty-state" hidden class="ct-empty">No coffees match the selected filters.</p>

  <div class="ct-table-wrap">
    <table id="coffee-table" class="ct-table">
      <thead>
        <tr>
          <th aria-sort="none">
            <button type="button" class="ct-sort-th" data-sort="name">
              Coffee <span class="ct-sort-ind" aria-hidden="true"></span>
            </button>
          </th>
          <th>Roaster</th>
          <th>Origin</th>
          <th>Process</th>
          <th class="ct-num" aria-sort="none">
            <button type="button" class="ct-sort-th ct-sort-th--num" data-sort="price">
              Price <span class="ct-sort-ind" aria-hidden="true"></span>
            </button>
          </th>
          <th class="ct-num ct-muted-h" aria-sort="none">
            <button type="button" class="ct-sort-th ct-sort-th--num" data-sort="per100g">
              Per 100g <span class="ct-sort-ind" aria-hidden="true"></span>
            </button>
          </th>
        </tr>
      </thead>
      <tbody>
        {coffees.map((c) => {
          const pType = processType(c.process ?? null);
          const per100gNum = c.weight_g ? (c.price / c.weight_g) * 100 : null;
          const per100g = per100gNum !== null ? fmtEur(per100gNum) : '—';
          const isBest =
            per100gNum !== null &&
            bestPer100g !== null &&
            per100gNum <= bestPer100g + 0.001;
          return (
            <tr
              data-name={c.name}
              data-roaster={c.roaster}
              data-origin={c.origin ?? ''}
              data-process={c.process ?? ''}
              data-roast={c.roast_type ?? ''}
              data-price={c.price}
              data-per100g={per100gNum !== null ? per100gNum.toFixed(4) : ''}
              class={isBest ? 'ct-row--best' : undefined}
            >
              <td>
                <a href={c.url} target="_blank" rel="noopener noreferrer" class="ct-link">
                  {c.name}
                  <svg class="ct-ext-icon" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                    <path d="M1.5 8.5L8.5 1.5M8.5 1.5H3.5M8.5 1.5V6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </td>
              <td>{c.roaster}</td>
              <td class="ct-muted">{c.origin ?? '—'}</td>
              <td>
                {c.process && pType
                  ? <span class={`ct-badge ct-badge--${pType}`}>{c.process}</span>
                  : c.process
                  ? <span class="ct-badge ct-badge--other">{c.process}</span>
                  : <span class="ct-muted">—</span>
                }
              </td>
              <td class="ct-num ct-price">{fmtEur(c.price)}</td>
              <td class="ct-num ct-muted">
                {per100g}
                {isBest && <span class="ct-best" title="Lowest price per 100g">best value</span>}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>

<script>
  const table       = document.getElementById('coffee-table')!;
  const tbody       = table.querySelector('tbody')!;
  const rows        = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr'));
  const emptyState  = document.getElementById('empty-state')!;
  const resultCount = document.getElementById('result-count')!;

  function populateSelect(id: string, attr: 'roaster' | 'origin' | 'process' | 'roast') {
    const select = document.getElementById(id) as HTMLSelectElement | null;
    if (!select) return;
    const values = [...new Set(rows.map(r => r.dataset[attr]).filter(Boolean))].sort(
      (a, b) => (a as string).localeCompare(b as string, 'sk'),
    ) as string[];
    for (const value of values) {
      if (select.querySelector(`option[value="${value}"]`)) continue;
      const opt = document.createElement('option');
      opt.value = value;
      opt.textContent = value;
      select.appendChild(opt);
    }
  }
  populateSelect('filter-roaster', 'roaster');
  populateSelect('filter-origin', 'origin');
  populateSelect('filter-process', 'process');

  const searchInput = document.getElementById('filter-search')  as HTMLInputElement;
  const roasterSel  = document.getElementById('filter-roaster') as HTMLSelectElement;
  const originSel   = document.getElementById('filter-origin')  as HTMLSelectElement;
  const processSel  = document.getElementById('filter-process') as HTMLSelectElement;
  const roastSel    = document.getElementById('filter-roast')   as HTMLSelectElement | null;
  const clearBtn    = document.getElementById('clear-filters')  as HTMLButtonElement;
  const sortBtns    = Array.from(
    table.querySelectorAll<HTMLButtonElement>('.ct-sort-th'),
  );

  let searchTerm = '';

  function filtersActive() {
    return !!(searchTerm || roasterSel.value || originSel.value || processSel.value || roastSel?.value);
  }

  function applyFilters() {
    const roaster = roasterSel.value;
    const origin  = originSel.value;
    const process = processSel.value;
    const roast   = roastSel?.value ?? '';
    const q = searchTerm;
    let count = 0;
    for (const row of rows) {
      const haystack =
        (row.dataset.name || '').toLowerCase() + ' ' +
        (row.dataset.roaster || '').toLowerCase();
      const match =
        (!q       || haystack.includes(q))                &&
        (!roaster || row.dataset.roaster === roaster)     &&
        (!origin  || row.dataset.origin  === origin)      &&
        (!process || row.dataset.process === process)     &&
        (!roast   || row.dataset.roast   === roast);
      row.hidden = !match;
      if (match) count++;
    }
    emptyState.hidden = count > 0;
    resultCount.textContent = `${count} coffee${count !== 1 ? 's' : ''}`;
    clearBtn.hidden = !filtersActive();
  }

  // ── Sorting: click a column header to sort, click again to flip ──
  type SortKey = 'name' | 'price' | 'per100g';
  let sortState: { key: SortKey; dir: 'asc' | 'desc' } | null = null;

  function valueFor(row: HTMLTableRowElement, key: SortKey): number | string {
    if (key === 'name') return (row.dataset.name || '').toLowerCase();
    if (key === 'price') return parseFloat(row.dataset.price || '0');
    // per100g: missing weight sorts to the bottom regardless of direction
    const raw = row.dataset.per100g;
    return raw ? parseFloat(raw) : Number.POSITIVE_INFINITY;
  }

  function applySort() {
    if (!sortState) return;
    const { key, dir } = sortState;
    const factor = dir === 'asc' ? 1 : -1;
    const sorted = [...rows].sort((a, b) => {
      const va = valueFor(a, key);
      const vb = valueFor(b, key);
      // Keep rows without a per-100g value pinned to the bottom.
      if (va === Number.POSITIVE_INFINITY && vb !== Number.POSITIVE_INFINITY) return 1;
      if (vb === Number.POSITIVE_INFINITY && va !== Number.POSITIVE_INFINITY) return -1;
      let diff: number;
      if (typeof va === 'string' || typeof vb === 'string') {
        diff = String(va).localeCompare(String(vb), 'sk');
      } else {
        diff = va - vb;
      }
      return diff * factor;
    });
    for (const row of sorted) tbody.appendChild(row);
  }

  function updateSortUI() {
    for (const btn of sortBtns) {
      const th = btn.closest('th')!;
      const ind = btn.querySelector<HTMLElement>('.ct-sort-ind')!;
      if (sortState && btn.dataset.sort === sortState.key) {
        btn.classList.add('ct-sort-th--active');
        th.setAttribute('aria-sort', sortState.dir === 'asc' ? 'ascending' : 'descending');
        ind.textContent = sortState.dir === 'asc' ? '↑' : '↓';
      } else {
        btn.classList.remove('ct-sort-th--active');
        th.setAttribute('aria-sort', 'none');
        ind.textContent = '';
      }
    }
  }

  for (const btn of sortBtns) {
    btn.addEventListener('click', () => {
      const key = btn.dataset.sort as SortKey;
      if (sortState && sortState.key === key) {
        sortState.dir = sortState.dir === 'asc' ? 'desc' : 'asc';
      } else {
        sortState = { key, dir: 'asc' };
      }
      updateSortUI();
      applySort();
    });
  }

  // Debounced text search.
  let searchTimer: ReturnType<typeof setTimeout>;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimer);
    searchTimer = setTimeout(() => {
      searchTerm = searchInput.value.trim().toLowerCase();
      applyFilters();
    }, 150);
  });

  roasterSel.addEventListener('change', applyFilters);
  originSel.addEventListener('change',  applyFilters);
  processSel.addEventListener('change', applyFilters);
  roastSel?.addEventListener('change',  applyFilters);

  clearBtn.addEventListener('click', () => {
    searchInput.value = '';
    searchTerm = '';
    roasterSel.value = '';
    originSel.value  = '';
    processSel.value = '';
    if (roastSel) roastSel.value = '';
    applyFilters();
    searchInput.focus();
  });

  // Default sort: cheapest first, matching the previous price-asc behaviour.
  sortState = { key: 'price', dir: 'asc' };
  updateSortUI();
  applyFilters();
  applySort();
</script>

<style>
  .ct-wrap {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  /* ── Stats / freshness header ─────────────────────────────── */
  .ct-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    background: var(--md-sys-color-surface-container-lowest);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    overflow: hidden;
    border-top: 3px solid var(--md-sys-color-primary);
  }

  .ct-stat {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.9rem 1.5rem;
    border-right: 1px solid var(--md-sys-color-outline-variant);
  }

  .ct-stat:last-child { border-right: none; }

  .ct-stat-value {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.5vw, 1.6rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--md-sys-color-on-surface);
    font-variant-numeric: tabular-nums;
  }

  .ct-stat-label {
    font-size: var(--md-sys-typescale-label-small-size);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--md-sys-color-outline);
  }

  .ct-stat--fresh {
    margin-left: auto;
    text-align: right;
  }

  .ct-stat--fresh .ct-stat-value,
  .ct-stat--fresh .ct-stat-label {
    justify-content: flex-end;
  }

  .ct-fresh-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--md-sys-color-secondary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--md-sys-color-secondary) 25%, transparent);
  }

  /* ── Toolbar ──────────────────────────────────────────────── */
  .ct-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.75rem 1rem;
    padding: 1rem 1.25rem;
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-left: 3px solid var(--md-sys-color-primary);
    border-radius: var(--md-sys-shape-corner-large);
  }

  .ct-search-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .ct-search-field {
    position: relative;
    display: flex;
    align-items: center;
  }

  .ct-search-icon {
    position: absolute;
    left: 0.65rem;
    color: var(--md-sys-color-outline);
    pointer-events: none;
  }

  .ct-search {
    padding: 0.35rem 0.7rem 0.35rem 2rem;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface);
    font-size: var(--md-sys-typescale-body-medium-size);
    min-width: 13rem;
    transition:
      border-color var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard),
      background var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard);
  }

  .ct-search::placeholder { color: var(--md-sys-color-outline); }

  .ct-search:hover {
    border-color: var(--md-sys-color-outline);
    background: var(--md-sys-color-surface-container-highest);
  }

  .ct-search:focus-visible {
    outline: none;
    box-shadow: var(--md3-focus-ring);
    border-color: var(--md-sys-color-primary);
  }

  .ct-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    flex: 1;
  }

  .ct-filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .ct-label {
    font-family: var(--font-mono);
    font-size: var(--md-sys-typescale-label-small-size);
    font-weight: var(--md-sys-typescale-label-small-weight);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--md-sys-color-outline);
  }

  .ct-select {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface);
    font-size: var(--md-sys-typescale-body-medium-size);
    min-width: 9rem;
    cursor: pointer;
    transition:
      border-color var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard),
      background var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard);
  }

  .ct-select:hover {
    border-color: var(--md-sys-color-outline);
    background: var(--md-sys-color-surface-container-highest);
  }

  .ct-select:focus-visible {
    outline: none;
    box-shadow: var(--md3-focus-ring);
    border-color: var(--md-sys-color-primary);
  }

  .ct-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  /* MD3 Text Button */
  .ct-clear-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    border: none;
    border-radius: var(--md-sys-shape-corner-full);
    background: transparent;
    color: var(--md-sys-color-primary);
    font-size: var(--md-sys-typescale-label-large-size);
    font-weight: var(--md-sys-typescale-label-large-weight);
    cursor: pointer;
    transition: background var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard);
    white-space: nowrap;
  }

  .ct-clear-btn:hover { background: var(--md3-state-hover, color-mix(in srgb, var(--md-sys-color-primary) 8%, transparent)); }

  .ct-clear-btn:focus-visible {
    outline: none;
    box-shadow: var(--md3-focus-ring);
  }

  .ct-count {
    font-family: var(--font-mono);
    font-size: var(--md-sys-typescale-label-medium-size);
    color: var(--md-sys-color-outline);
    white-space: nowrap;
    min-width: 5.5rem;
    text-align: right;
  }

  /* ── Table ────────────────────────────────────────────────── */
  .ct-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    background: var(--md-sys-color-surface-container-lowest);
  }

  .ct-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--md-sys-typescale-body-medium-size);
  }

  .ct-table thead {
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .ct-table thead th {
    padding: 0.65rem 1rem;
    background: var(--md-sys-color-surface-variant);
    font-family: var(--font-mono);
    font-size: var(--md-sys-typescale-label-small-size);
    font-weight: var(--md-sys-typescale-label-small-weight);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--md-sys-color-outline);
    text-align: left;
    border-bottom: 2px solid var(--md-sys-color-outline-variant);
    white-space: nowrap;
  }

  /* Sortable header buttons */
  .ct-sort-th {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0;
    margin: 0;
    border: none;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    color: inherit;
    cursor: pointer;
    transition: color var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard);
  }

  .ct-sort-th--num { flex-direction: row-reverse; }

  .ct-sort-th:hover { color: var(--md-sys-color-on-surface); }

  .ct-sort-th--active { color: var(--md-sys-color-primary); }

  .ct-sort-th:focus-visible {
    outline: none;
    box-shadow: var(--md3-focus-ring);
    border-radius: var(--md-sys-shape-corner-extra-small, 4px);
  }

  .ct-sort-ind {
    font-size: 0.85em;
    min-width: 0.7em;
    line-height: 1;
  }

  .ct-table tbody tr {
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    transition: background var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard);
  }

  .ct-table tbody tr:last-child { border-bottom: none; }

  .ct-table tbody tr:hover {
    background: var(--md3-state-on-surface-hover);
  }

  .ct-table tbody td {
    padding: 0.7rem 1rem;
    vertical-align: middle;
    color: var(--md-sys-color-on-surface-variant);
  }

  .ct-num {
