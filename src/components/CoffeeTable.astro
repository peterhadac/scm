---
import sampleCoffees from '../../_data/coffees.sample.json';
import prodCoffees from '../../_data/coffees.json';

const coffees = import.meta.env.DEV ? sampleCoffees : prodCoffees;

function processType(p: string | null): 'washed' | 'natural' | 'honey' | null {
  if (!p) return null;
  const l = p.toLowerCase();
  if (l.includes('umyt') || l.includes('washed')) return 'washed';
  if (l.includes('prírodn') || l.includes('natural')) return 'natural';
  if (l.includes('med') || l.includes('honey')) return 'honey';
  return null;
}
---

<div class="ct-wrap">
  <div class="ct-toolbar">
    <div class="ct-filters">
      <div class="ct-filter-group">
        <label class="ct-label" for="filter-roaster">Roaster</label>
        <select id="filter-roaster" class="ct-select"><option value="">All</option></select>
      </div>
      <div class="ct-filter-group">
        <label class="ct-label" for="filter-origin">Origin</label>
        <select id="filter-origin" class="ct-select"><option value="">All</option></select>
      </div>
      <div class="ct-filter-group">
        <label class="ct-label" for="filter-process">Process</label>
        <select id="filter-process" class="ct-select"><option value="">All</option></select>
      </div>
    </div>
    <div class="ct-actions">
      <button id="sort-price" type="button" class="ct-sort-btn" data-dir="asc">
        Price <span id="sort-icon" aria-hidden="true">↑</span>
      </button>
      <span id="result-count" class="ct-count" aria-live="polite"></span>
    </div>
  </div>

  <p id="empty-state" hidden class="ct-empty">No coffees match the selected filters.</p>

  <div class="ct-table-wrap">
    <table id="coffee-table" class="ct-table">
      <thead>
        <tr>
          <th>Coffee</th>
          <th>Roaster</th>
          <th>Origin</th>
          <th>Process</th>
          <th class="ct-num">Price</th>
          <th class="ct-num ct-muted-h">Per 100g</th>
        </tr>
      </thead>
      <tbody>
        {coffees.map((c) => {
          const pType = processType(c.process ?? null);
          const per100g = c.weight_g ? `€${(c.price / c.weight_g * 100).toFixed(2)}` : '—';
          return (
            <tr
              data-roaster={c.roaster}
              data-origin={c.origin ?? ''}
              data-process={c.process ?? ''}
              data-price={c.price}
            >
              <td>
                <a href={c.url} target="_blank" rel="noopener noreferrer" class="ct-link">
                  {c.name}
                  <svg class="ct-ext-icon" width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
                    <path d="M1.5 8.5L8.5 1.5M8.5 1.5H3.5M8.5 1.5V6.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </td>
              <td>{c.roaster}</td>
              <td class="ct-muted">{c.origin ?? '—'}</td>
              <td>
                {c.process && pType
                  ? <span class={`ct-badge ct-badge--${pType}`}>{c.process}</span>
                  : c.process
                  ? <span class="ct-badge ct-badge--other">{c.process}</span>
                  : <span class="ct-muted">—</span>
                }
              </td>
              <td class="ct-num ct-price">€{c.price.toFixed(2)}</td>
              <td class="ct-num ct-muted">{per100g}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</div>

<script>
  const table       = document.getElementById('coffee-table')!;
  const tbody       = table.querySelector('tbody')!;
  const rows        = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr'));
  const emptyState  = document.getElementById('empty-state')!;
  const resultCount = document.getElementById('result-count')!;

  function populateSelect(id: string, attr: 'roaster' | 'origin' | 'process') {
    const select = document.getElementById(id) as HTMLSelectElement;
    const values = [...new Set(rows.map(r => r.dataset[attr]).filter(Boolean))].sort() as string[];
    for (const value of values) {
      const opt = document.createElement('option');
      opt.value = value;
      opt.textContent = value;
      select.appendChild(opt);
    }
  }
  populateSelect('filter-roaster', 'roaster');
  populateSelect('filter-origin', 'origin');
  populateSelect('filter-process', 'process');

  const roasterSel = document.getElementById('filter-roaster') as HTMLSelectElement;
  const originSel  = document.getElementById('filter-origin')  as HTMLSelectElement;
  const processSel = document.getElementById('filter-process') as HTMLSelectElement;
  const sortBtn    = document.getElementById('sort-price')     as HTMLButtonElement;
  const sortIcon   = document.getElementById('sort-icon')      as HTMLElement;

  function applyFilters() {
    const roaster = roasterSel.value;
    const origin  = originSel.value;
    const process = processSel.value;
    let count = 0;
    for (const row of rows) {
      const match =
        (!roaster || row.dataset.roaster === roaster) &&
        (!origin  || row.dataset.origin  === origin)  &&
        (!process || row.dataset.process === process);
      row.hidden = !match;
      if (match) count++;
    }
    emptyState.hidden = count > 0;
    resultCount.textContent = `${count} coffee${count !== 1 ? 's' : ''}`;
  }

  function applySort() {
    const asc = sortBtn.dataset.dir === 'asc';
    const sorted = [...rows].sort((a, b) => {
      const diff = parseFloat(a.dataset.price!) - parseFloat(b.dataset.price!);
      return asc ? diff : -diff;
    });
    for (const row of sorted) tbody.appendChild(row);
  }

  roasterSel.addEventListener('change', applyFilters);
  originSel.addEventListener('change',  applyFilters);
  processSel.addEventListener('change', applyFilters);

  sortBtn.addEventListener('click', () => {
    const wasAsc = sortBtn.dataset.dir === 'asc';
    sortBtn.dataset.dir = wasAsc ? 'desc' : 'asc';
    sortIcon.textContent = wasAsc ? '↓' : '↑';
    sortBtn.classList.toggle('ct-sort-btn--active', !wasAsc);
    applySort();
  });

  applyFilters();
  applySort();
</script>

<style>
  .ct-wrap {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  /* ── Toolbar ──────────────────────────────────────────────── */
  .ct-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.75rem 1rem;
    padding: 1rem 1.25rem;
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
  }

  .ct-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    flex: 1;
  }

  .ct-filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .ct-label {
    font-size: var(--md-sys-typescale-label-small-size);
    font-weight: var(--md-sys-typescale-label-small-weight);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--md-sys-color-outline);
  }

  .ct-select {
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-small);
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface);
    font-size: var(--md-sys-typescale-body-medium-size);
    min-width: 9rem;
    cursor: pointer;
    transition:
      border-color var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard),
      background var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard);
  }

  .ct-select:hover {
    border-color: var(--md-sys-color-outline);
    background: var(--md-sys-color-surface-container-highest);
  }

  .ct-select:focus-visible {
    outline: none;
    box-shadow: var(--md3-focus-ring);
    border-color: var(--md-sys-color-primary);
  }

  .ct-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  /* MD3 Outlined Button */
  .ct-sort-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 1rem;
    border: 1px solid var(--md-sys-color-outline);
    border-radius: var(--md-sys-shape-corner-full);
    background: transparent;
    color: var(--md-sys-color-primary);
    font-size: var(--md-sys-typescale-label-large-size);
    font-weight: var(--md-sys-typescale-label-large-weight);
    cursor: pointer;
    transition:
      background var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard),
      border-color var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard);
    white-space: nowrap;
  }

  .ct-sort-btn:hover {
    background: var(--md3-state-hover);
    border-color: var(--md-sys-color-primary);
  }

  .ct-sort-btn--active {
    background: var(--md-sys-color-primary-container);
    border-color: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary-container);
  }

  .ct-sort-btn:focus-visible {
    outline: none;
    box-shadow: var(--md3-focus-ring);
  }

  .ct-count {
    font-size: var(--md-sys-typescale-label-medium-size);
    color: var(--md-sys-color-outline);
    white-space: nowrap;
    min-width: 5.5rem;
    text-align: right;
  }

  /* ── Table ────────────────────────────────────────────────── */
  .ct-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    background: var(--md-sys-color-surface-container-lowest);
  }

  .ct-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--md-sys-typescale-body-medium-size);
  }

  .ct-table thead {
    position: sticky;
    top: 0;
    z-index: 1;
  }

  .ct-table thead th {
    padding: 0.7rem 1rem;
    background: var(--md-sys-color-surface-container);
    font-size: var(--md-sys-typescale-label-small-size);
    font-weight: var(--md-sys-typescale-label-small-weight);
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--md-sys-color-outline);
    text-align: left;
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    white-space: nowrap;
  }

  .ct-table tbody tr {
    border-bottom: 1px solid var(--md-sys-color-outline-variant);
    transition: background var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard);
  }

  .ct-table tbody tr:last-child { border-bottom: none; }

  .ct-table tbody tr:hover {
    background: var(--md3-state-on-surface-hover);
  }

  .ct-table tbody td {
    padding: 0.7rem 1rem;
    vertical-align: middle;
    color: var(--md-sys-color-on-surface-variant);
  }

  .ct-num {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .ct-muted   { color: var(--md-sys-color-outline); }
  .ct-muted-h { color: var(--md-sys-color-outline); }
  .ct-price   { font-weight: 600; color: var(--md-sys-color-on-surface); }

  /* ── Coffee link ──────────────────────────────────────────── */
  .ct-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-weight: var(--md-sys-typescale-title-small-weight);
    color: var(--md-sys-color-on-surface);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition:
      color var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard),
      border-color var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard);
  }

  .ct-link:hover {
    color: var(--md-sys-color-primary);
    border-bottom-color: color-mix(in srgb, var(--md-sys-color-primary) 50%, transparent);
  }

  .ct-ext-icon {
    flex-shrink: 0;
    opacity: 0.35;
    transition: opacity var(--md3-motion-duration-state) var(--md-sys-motion-easing-standard);
  }

  .ct-link:hover .ct-ext-icon { opacity: 0.9; }

  /* ── Process badges — use MD3 role colors ─────────────────── */
  .ct-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.18em 0.65em;
    border-radius: var(--md-sys-shape-corner-full);
    font-size: var(--md-sys-typescale-label-small-size);
    font-weight: var(--md-sys-typescale-label-small-weight);
    letter-spacing: 0.02em;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  /* washed → primary role */
  .ct-badge--washed {
    background: var(--md-sys-color-primary-container);
    color: var(--md-sys-color-on-primary-container);
    border-color: color-mix(in srgb, var(--md-sys-color-primary) 32%, transparent);
  }

  /* natural → tertiary role */
  .ct-badge--natural {
    background: var(--md-sys-color-tertiary-container);
    color: var(--md-sys-color-on-tertiary-container);
    border-color: color-mix(in srgb, var(--md-sys-color-tertiary) 32%, transparent);
  }

  /* honey → secondary role */
  .ct-badge--honey {
    background: var(--md-sys-color-secondary-container);
    color: var(--md-sys-color-on-secondary-container);
    border-color: color-mix(in srgb, var(--md-sys-color-secondary) 32%, transparent);
  }

  .ct-badge--other {
    background: var(--md-sys-color-surface-container-high);
    color: var(--md-sys-color-on-surface-variant);
    border-color: var(--md-sys-color-outline-variant);
  }

  /* ── Empty state ──────────────────────────────────────────── */
  .ct-empty {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--md-sys-color-outline);
    font-size: var(--md-sys-typescale-body-medium-size);
    background: var(--md-sys-color-surface-container);
    border: 1px solid var(--md-sys-color-outline-variant);
    border-radius: var(--md-sys-shape-corner-large);
    margin: 0;
  }

  /* ── Responsive ───────────────────────────────────────────── */
  @media (max-width: 640px) {
    .ct-toolbar {
      flex-direction: column;
      align-items: stretch;
    }
    .ct-actions {
      margin-left: 0;
      justify-content: space-between;
    }
  }
</style>
