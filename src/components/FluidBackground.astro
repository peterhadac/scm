---
// Quiet noise texture for the hero — subtle grain that gives the dark panel
// visual depth without the previous CSS blob-morph + coffee bubbles.
// A static SVG noise filter that runs on the background layer only.
---

<div class="fluid-bg" aria-hidden="true">
  <svg class="fluid-svg" preserveAspectRatio="none" viewBox="0 0 100 100">
    <filter id="fluid-grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch" />
      <feColorMatrix type="saturate" values="0" />
    </filter>
    <rect width="100" height="100" filter="url(#fluid-grain)" opacity="0.04" />
  </svg>
</div>

<style>
  .fluid-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .fluid-svg {
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    /* Grain is static, no animation to reduce. */
  }
</style>
