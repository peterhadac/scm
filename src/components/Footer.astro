---
// Freshness badge (issue #61): "data updated <date>" in every page's
// footer, computed at build time from the newest last_seen across all ok
// products. Turns into the tertiary (warning) role once the newest data is
// older than 8 days — one missed weekly cycle — because a stale site looks
// identical to a fresh one otherwise (a failed deploy or scrape leaves the
// last good build up silently). Wraps Starlight's default Footer rather
// than replacing it, so pagination/edit links keep working.
import Default from '@astrojs/starlight/components/Footer.astro';
import { flattenProducts } from '../lib/coffees';
import type { Lang } from '../lib/i18n';

const lang: Lang = Astro.locals.starlightRoute.lang === 'sk' ? 'sk' : 'en';

const lastUpdated = flattenProducts().reduce(
  (max, c) => (c.last_seen && c.last_seen > max ? c.last_seen : max),
  '',
);
const STALE_AFTER_DAYS = 8;
const ageDays = lastUpdated
  ? (Date.now() - new Date(lastUpdated).getTime()) / (1000 * 60 * 60 * 24)
  : Infinity;
const stale = ageDays > STALE_AFTER_DAYS;

const label =
  lang === 'sk'
    ? `Dáta aktualizované ${lastUpdated || '—'}`
    : `Data updated ${lastUpdated || '—'}`;
const staleNote =
  lang === 'sk'
    ? ' (staršie ako týždeň — aktualizácia mešká)'
    : ' (over a week old — update is overdue)';

// "Report a problem" link (issue #85) → GitHub's issue-template chooser.
const reportLabel = lang === 'sk' ? 'Nahlásiť problém' : 'Report a problem';
const reportUrl = 'https://github.com/peterhadac/scm/issues/new/choose';
---

<Default><slot /></Default>
{lastUpdated && (
  <p class:list={['data-freshness', { 'data-freshness--stale': stale }]}>
    {label}
    {stale && staleNote}
  </p>
)}
<p class="report-problem">
  <a href={reportUrl} target="_blank" rel="noopener noreferrer">{reportLabel}</a>
</p>

<style>
  .data-freshness {
    margin: 0.5rem 0 0;
    font-size: var(--md-sys-typescale-label-small-size, 0.75rem);
    color: var(--md-sys-color-outline, var(--sl-color-gray-3));
  }
  /* Reuses the tertiary role already carrying "may be outdated" meaning
     (stale row icon) — no new color, per Design.md. */
  .data-freshness--stale {
    color: var(--md-sys-color-tertiary, var(--sl-color-orange));
    font-weight: 500;
  }
  .report-problem {
    margin: 0.25rem 0 0;
    font-size: var(--md-sys-typescale-label-small-size, 0.75rem);
  }
  .report-problem a {
    color: var(--md-sys-color-outline, var(--sl-color-gray-3));
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .report-problem a:hover {
    color: var(--md-sys-color-primary, var(--sl-color-text-accent));
  }
</style>
