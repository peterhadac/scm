---
// Wraps Starlight's default Footer rather than replacing it, so pagination/
// edit links keep working. The freshness badge itself lives in
// FreshnessBadge.astro (issue #121), shared with the new non-Starlight
// Layout.astro footer.
import Default from '@astrojs/starlight/components/Footer.astro';
import FreshnessBadge from './FreshnessBadge.astro';
import type { Lang } from '../lib/i18n';

const lang: Lang = Astro.locals.starlightRoute.lang === 'sk' ? 'sk' : 'en';
---

<Default><slot /></Default>
<FreshnessBadge lang={lang} />
