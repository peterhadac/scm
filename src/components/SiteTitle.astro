---
// ponytail: icon + wordmark lockup per Design.md — no logo image/logos config,
// so this replaces Starlight's default SiteTitle instead of layering on top of it.
import LogoIcon from './LogoIcon.astro';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="wordmark sl-flex" aria-label="Slovak Coffee Map">
  <LogoIcon size={32} />
  <span class="wordmark-text">
    <span class="wordmark-line1">Slovak</span>
    <span class="wordmark-line2">COFFEE MAP</span>
  </span>
</a>

<style>
  @layer starlight.core {
    .wordmark {
      flex-direction: row;
      align-items: center;
      gap: 0.5rem;
      line-height: 1.1;
      text-decoration: none;
      white-space: nowrap;
      min-width: 0;
    }

    .wordmark-text {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      min-width: 0;
    }

    .wordmark-line1 {
      font-family: var(--font-serif);
      font-size: 1.25rem;
      letter-spacing: -0.02em;
      color: var(--wordmark-slovak);
    }

    .wordmark-line2 {
      font-family: var(--font-sans);
      font-weight: 300;
      font-size: 0.625rem;
      letter-spacing: 0.28em;
      margin-left: 5%;
      color: var(--wordmark-coffeemap);
    }
  }
</style>
