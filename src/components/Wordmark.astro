---
// Icon + wordmark lockup per Design.md "Icon + Wordmark Lockup". Extracted
// from SiteTitle.astro (issue #121) so both the Starlight chrome and the
// new Layout.astro can render the same brand mark from a plain `href` prop.
import LogoIcon from './LogoIcon.astro';
interface Props {
  href: string;
}
const { href } = Astro.props;
---

<a href={href} class="wordmark" aria-label="Slovak Coffee Map">
  <LogoIcon size={32} />
  <span class="wordmark-text">
    <span class="wordmark-line1">Slovak</span>
    <span class="wordmark-line2">COFFEE MAP</span>
  </span>
</a>

<style>
  .wordmark {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.5rem;
    line-height: 1.1;
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  .wordmark-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
  }

  .wordmark-line1 {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--wordmark-slovak);
  }

  .wordmark-line2 {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: 0.625rem;
    letter-spacing: 0.28em;
    margin-left: 5%;
    color: var(--wordmark-coffeemap);
  }
</style>
