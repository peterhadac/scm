---
// Flat Button, themed to Design.md's six brand tokens. No candy gloss,
// no multi-layer shadows — just a clean, tactile pill with a color transition
// on hover and a subtle physical press on active. Replaces the
// "candy" treatment from the previous version.
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '../../lib/utils';

const buttonVariants = cva(
  'relative isolate inline-flex items-center justify-center rounded-full font-sans font-medium border transition-colors duration-150 active:translate-y-[1px] disabled:pointer-events-none disabled:opacity-40 disabled:active:translate-y-0 focus-visible:outline-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary',
  {
    variants: {
      variant: {
        primary:
          'border-transparent text-white bg-secondary hover:bg-primary hover:brightness-95 active:bg-primary',
        secondary:
          'border-outline/40 bg-surface text-on-surface hover:border-primary hover:text-primary',
      },
      size: {
        default: 'px-6 py-2.5 text-sm',
        sm: 'px-4 py-1.5 text-xs',
      },
    },
    defaultVariants: {
      variant: 'primary',
      size: 'default',
    },
  },
);

interface Props extends VariantProps<typeof buttonVariants> {
  href?: string;
  class?: string;
  target?: string;
  rel?: string;
}

const { href, variant, size, class: className, target, rel } = Astro.props;
const classes = cn(buttonVariants({ variant, size }), className);
const Tag = href ? 'a' : 'button';
---

<Tag class={classes} href={href} target={target} rel={rel} type={href ? undefined : 'button'}>
  <slot />
</Tag>
