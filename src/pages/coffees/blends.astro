---
import Layout from '../../layouts/Layout.astro';
import RoastTabs from '../../components/RoastTabs.astro';
import CoffeeTable from '../../components/CoffeeTable.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Blends" description="Browse multi-origin blend coffees currently in stock from Slovak roasters.">
  <h1>Blends</h1>
  <RoastTabs activeRoast="blends" lang="en" base={base} />
  <CoffeeTable lang="en" blend={true} />
</Layout>
