---
import Layout from '../../layouts/Layout.astro';
import RoastTabs from '../../components/RoastTabs.astro';
import CoffeeTable from '../../components/CoffeeTable.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Decaf coffees" description="Browse decaffeinated coffees currently in stock from Slovak roasters.">
  <h1>Decaf</h1>
  <RoastTabs activeRoast="decaf" lang="en" base={base} />
  <CoffeeTable lang="en" />
</Layout>
