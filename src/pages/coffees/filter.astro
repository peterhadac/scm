---
import Layout from '../../layouts/Layout.astro';
import RoastTabs from '../../components/RoastTabs.astro';
import CoffeeTable from '../../components/CoffeeTable.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Filter coffees" description="Browse filter (drip) roast coffees currently in stock from Slovak roasters.">
  <h1>Filter coffees</h1>
  <RoastTabs activeRoast="filter" lang="en" base={base} />
  <CoffeeTable lang="en" roastType="filter" blend={false} />
</Layout>
