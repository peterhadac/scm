---
// Landing page, migrated off Starlight's splash template (issue #121). SK
// mirror: src/pages/sk/index.astro. Content ported verbatim from the old
// src/content/docs/index.mdx (now unused by this route).
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import CardGrid from '../components/CardGrid.astro';
import MemeCard from '../components/MemeCard.astro';
import Button from '../components/ui/Button.astro';
import FluidBackground from '../components/FluidBackground.astro';
import RoasterLogoSlider from '../components/RoasterLogoSlider.astro';
import { topRoastersByCoffeeCount } from '../lib/coffees';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const topRoasters = topRoastersByCoffeeCount();

const heroSvg = `<svg width="200" height="220" viewBox="0 0 200 220" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M100 20 C63 20 34 49 34 86 C34 133 100 215 100 215 C100 215 166 133 166 86 C166 49 137 20 100 20Z" fill="color-mix(in oklch, var(--md-sys-color-primary) 12%, transparent)" stroke="var(--md-sys-color-primary)" stroke-width="2.5"/><ellipse cx="100" cy="86" rx="30" ry="37" fill="none" stroke="var(--md-sys-color-primary)" stroke-width="2.5"/><path d="M100 49 C88 61 88 73 100 86 C112 99 112 111 100 123" stroke="var(--md-sys-color-primary)" stroke-width="2" stroke-linecap="round" fill="none"/></svg>`;
---

<Layout
  title="Slovak Coffee Map"
  description="Heureka for specialty coffee — every coffee in stock at Slovak roasters, compared in one place and refreshed weekly."
>
  <section class="hero">
    <FluidBackground />
    <div class="hero-image" set:html={heroSvg} />
    <h1>Slovak Coffee Map</h1>
    <p class="tagline">
      Heureka for specialty coffee — every coffee currently in stock at
      Slovak roasters, compared in one filterable table and refreshed every
      Monday.
    </p>
    <div class="hero-actions">
      <Button href={`${base}/coffees/`} variant="primary">Browse coffees →</Button>
      <Button href={`${base}/this-week/`} variant="secondary">What changed this week</Button>
    </div>
  </section>

  <RoasterLogoSlider roasters={topRoasters} lang="en" />

  <CardGrid>
    <Card title="Compare, don't tab-hop">
      ~30 Slovak roasters and ~600 coffees in one table — filter by origin,
      process, and roast, sort by price per 100 g, and buy directly from the
      roaster. Nobody pays to be listed.
    </Card>
    <Card title="Fresh every Monday">
      An automated scrape confirms every price and delisting weekly. Stale
      data gets flagged, not hidden.
    </Card>
    <Card title="Catch the price drops">
      Price history per coffee, drop badges in the table, and a weekly
      changes page with an RSS feed.
    </Card>
    <Card title="Explore by origin">
      Landing pages and a world map for every origin country on the Slovak
      market — from Brazil to Yemen.
    </Card>
  </CardGrid>

  <MemeCard
    src={`${base}/kamenicky-2024.jpg`}
    alt="Ladislav Kamenický, Slovak Minister of Finance"
    caption="Coffee got pricier? Wasn't us. Consolidation."
    credit="Photo: © European Union, 2024 (Jennifer Jacquemart), CC BY 4.0, via Wikimedia Commons"
    creditHref="https://commons.wikimedia.org/wiki/File:Ladislav_Kamenicky,_2024.jpg"
  />

  <p class="closing">
    At least here you can see exactly who raised which price, and when. The
    map is independent, free, and built for people who take their coffee —
    if not their fiscal policy — seriously.
  </p>
</Layout>

<style>
  .hero {
    position: relative;
    text-align: center;
    padding: 2rem 0 3rem;
  }

  .hero-image {
    margin: 0 auto 1rem;
    width: 10rem;
    /* Drop-shadow filter lives on the global `.hero-image svg` rule in
       custom.css, not here — this rule used to duplicate it verbatim. */
  }

  .hero h1 {
    font-family: var(--font-serif);
    font-size: var(--md-sys-typescale-display-small-size);
    letter-spacing: var(--md-sys-typescale-display-small-tracking);
    margin: 0 0 1rem;
  }

  .tagline {
    max-width: 40rem;
    margin: 0 auto 1.5rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: var(--md-sys-typescale-title-medium-size);
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .closing {
    max-width: 40rem;
    margin: 2rem auto 0;
    text-align: center;
    color: var(--md-sys-color-on-surface-variant);
  }
</style>
