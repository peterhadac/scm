---
// Origins index (issue #58): internal-linking hub for the per-origin
// landing pages, ordered by catalogue size.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import OriginsChoropleth from '../../components/OriginsChoropleth.astro';
import { listOrigins } from '../../lib/origins';
import { localizedOrigin } from '../../lib/i18n';

const origins = listOrigins();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<StarlightPage
  frontmatter={{
    title: 'Coffee by origin',
    description: 'Browse coffees available in Slovakia by country of origin.',
    tableOfContents: false,
  }}
>
  <p>
    Every origin represented on the Slovak specialty market right now, most
    coffees first. Each page lists the country's coffees with prices,
    refreshed weekly.
  </p>
  <OriginsChoropleth />
  <ul>
    {origins.map((o) => (
      <li>
        <a href={`${base}/origins/${o.slug}/`}>
          {o.origin === 'Blend' ? 'Blends' : localizedOrigin(o.origin, 'en') ?? o.origin}
        </a>{' '}
        ({o.coffeeCount})
      </li>
    ))}
  </ul>
</StarlightPage>
