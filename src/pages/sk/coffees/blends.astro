---
import Layout from '../../layouts/Layout.astro';
import RoastTabs from '../../components/RoastTabs.astro';
import CoffeeTable from '../../components/CoffeeTable.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Zmesi" description="Prezerajte viaceročné zmesi káv dostupné od slovenských pražiarní.">
  <h1>Zmesi</h1>
  <RoastTabs activeRoast="blends" lang="sk" base={base} />
  <CoffeeTable lang="sk" blend={true} />
</Layout>
