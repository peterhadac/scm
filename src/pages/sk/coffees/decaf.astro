---
import Layout from '../../layouts/Layout.astro';
import RoastTabs from '../../components/RoastTabs.astro';
import CoffeeTable from '../../components/CoffeeTable.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Decaf kávy" description="Prezerajte dembezínové kávy dostupné od slovenských pražiarní.">
  <h1>Decaf</h1>
  <RoastTabs activeRoast="decaf" lang="sk" base={base} />
  <CoffeeTable lang="sk" />
</Layout>
