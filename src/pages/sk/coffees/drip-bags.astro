---
import Layout from '../../layouts/Layout.astro';
import RoastTabs from '../../components/RoastTabs.astro';
import CoffeeTable from '../../components/CoffeeTable.astro';

const base = import.meta.env.BASE_URL.replace(/\/\/$/, '');
---

<Layout title="Drip bagy" description="Prezerajte drip bagy dostupné od slovenských pražiarní.">
  <h1>Drip bagy</h1>
  <RoastTabs activeRoast="drip-bags" lang="sk" base={base} />
  <CoffeeTable lang="sk" roastType="drip-bag" />
</Layout>
