---
import Layout from '../../layouts/Layout.astro';
import RoastTabs from '../../components/RoastTabs.astro';
import CoffeeTable from '../../components/CoffeeTable.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Espresso kávy" description="Prezerajte espresso kávy dostupné od slovenských pražiarní.">
  <h1>Espresso kávy</h1>
  <RoastTabs activeRoast="espresso" lang="sk" base={base} />
  <CoffeeTable lang="sk" roastType="espresso" blend={false} />
</Layout>
