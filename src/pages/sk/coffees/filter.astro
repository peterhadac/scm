---
import Layout from '../../layouts/Layout.astro';
import RoastTabs from '../../components/RoastTabs.astro';
import CoffeeTable from '../../components/CoffeeTable.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Filter kávy" description="Prezerajte filter kávy dostupné od slovenských pražiarní.">
  <h1>Filter kávy</h1>
  <RoastTabs activeRoast="filter" lang="sk" base={base} />
  <CoffeeTable lang="sk" roastType="filter" blend={false} />
</Layout>
