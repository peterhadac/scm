---
import Layout from '../../layouts/Layout.astro';
import RoastTabs from '../../components/RoastTabs.astro';
import CoffeeTable from '../../components/CoffeeTable.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Kávy" description="Prezerajte a filtrujte všetky kávy dostupné od slovenských pražiarní.">
  <h1>Kávy</h1>
  <RoastTabs activeRoast={null} lang="sk" base={base} />
  <CoffeeTable lang="sk" />
</Layout>
