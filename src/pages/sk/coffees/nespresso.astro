---
import Layout from '../../layouts/Layout.astro';
import RoastTabs from '../../components/RoastTabs.astro';
import CoffeeTable from '../../components/CoffeeTable.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Nespresso kapsuly" description="Prezerajte Nespresso kompatibilné kapsuly dostupné od slovenských pražiarní.">
  <h1>Nespresso kapsuly</h1>
  <RoastTabs activeRoast="nespresso" lang="sk" base={base} />
  <CoffeeTable lang="sk" roastType="nespresso" />
</Layout>
