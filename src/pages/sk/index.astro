---
// SK mirror of src/pages/index.astro (issue #121). Content ported verbatim
// from the old src/content/docs/sk/index.mdx (now unused by this route).
import Layout from '../../layouts/Layout.astro';
import Card from '../../components/Card.astro';
import CardGrid from '../../components/CardGrid.astro';
import MemeCard from '../../components/MemeCard.astro';
import HeroVideoDark from '../../components/HeroVideoDark.astro';
import RoasterLogoSlider from '../../components/RoasterLogoSlider.astro';
import { topRoastersByCoffeeCount } from '../../lib/coffees';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const topRoasters = topRoastersByCoffeeCount();
---

<Layout
  title="Slovak Coffee Map"
  description="Heureka pre výberovú kávu — všetky kávy skladom u slovenských pražiarní, porovnané na jednom mieste a obnovované každý týždeň."
>
  <HeroVideoDark
    headingMuted="Slovak"
    headingBright="Coffee Map"
    body="Heureka pre výberovú kávu — všetky kávy aktuálne skladom u slovenských pražiarní, porovnané v jednej filtrovateľnej tabuľke a obnovované každý pondelok."
    buttons={[
      { label: 'Prehliadať kávy →', href: `${base}/sk/coffees/`, variant: 'primary' },
      { label: 'Čo sa zmenilo tento týždeň', href: `${base}/sk/this-week/`, variant: 'secondary' },
    ]}
  />

  <RoasterLogoSlider roasters={topRoasters} lang="sk" />

  <CardGrid>
    <Card title="Porovnávajte, nepreklikávajte">
      ~30 slovenských pražiarní a ~600 káv v jednej tabuľke — filtrujte podľa
      pôvodu, spracovania a praženia, zoraďte podľa ceny za 100 g a nakúpte
      priamo u pražiarne. Nikto neplatí za zaradenie.
    </Card>
    <Card title="Čerstvé každý pondelok">
      Automatický scraper týždenne overí každú cenu aj vyradenie z ponuky.
      Zastarané dáta označíme, neskrývame.
    </Card>
    <Card title="Chyťte zľavy včas">
      História cien pri každej káve, odznaky zliav v tabuľke a týždenný
      prehľad zmien s RSS feedom.
    </Card>
    <Card title="Objavujte podľa pôvodu">
      Stránky a mapa sveta pre každú krajinu pôvodu na slovenskom trhu — od
      Brazílie po Jemen.
    </Card>
  </CardGrid>

  <MemeCard
    src={`${base}/kamenicky-2024.jpg`}
    alt="Ladislav Kamenický, minister financií SR"
    caption="Káva zdražela? To nie my. Konsolidácia."
    credit="Foto: © Európska únia, 2024 (Jennifer Jacquemart), CC BY 4.0, cez Wikimedia Commons"
    creditHref="https://commons.wikimedia.org/wiki/File:Ladislav_Kamenicky,_2024.jpg"
  />

  <p class="closing">
    Aspoň tu presne vidíte, kto ktorú cenu zdvihol a kedy. Mapa je nezávislá,
    zadarmo a pre ľudí, ktorí berú svoju kávu — ak už nie fiškálnu politiku —
    vážne.
  </p>
</Layout>

<style>
  .closing {
    max-width: 40rem;
    margin: 2rem auto 0;
    text-align: center;
    color: var(--md-sys-color-on-surface-variant);
  }
</style>
